[*] GTKWave save file for the systolic-array demo (tb/tb_demo.v, N = 4).
[*] Open with:  make show_demo   (or: gtkwave waveforms/tb_demo.vcd waveforms/tb_demo.gtkw)
[dumpfile] "waveforms/tb_demo.vcd"
[timestart] 360000
[size] 1600 900
[pos] -1 -1
[sst_width] 220
[signals_width] 300
[sst_expanded] 1
[sst_vpaned_height] 250
@28
tb_demo.clk
tb_demo.start
@200
-FSM state: 0 IDLE, 1 CLEAR, 2 RUN, 3 DONE
@22
+{state} tb_demo.u_sys.u_ctrl.state[1:0]
@200
-A enters from the west (row i delayed i cycles)
@424
+{a_west[0]} tb_demo.u_sys.u_array.g_row[0].g_col[0].u_pe.a_in[7:0]
+{a_west[1]} tb_demo.u_sys.u_array.g_row[1].g_col[0].u_pe.a_in[7:0]
+{a_west[2]} tb_demo.u_sys.u_array.g_row[2].g_col[0].u_pe.a_in[7:0]
+{a_west[3]} tb_demo.u_sys.u_array.g_row[3].g_col[0].u_pe.a_in[7:0]
@200
-B enters from the north (column j delayed j cycles)
@424
+{b_north[0]} tb_demo.u_sys.u_array.g_row[0].g_col[0].u_pe.b_in[7:0]
+{b_north[1]} tb_demo.u_sys.u_array.g_row[0].g_col[1].u_pe.b_in[7:0]
+{b_north[2]} tb_demo.u_sys.u_array.g_row[0].g_col[2].u_pe.b_in[7:0]
+{b_north[3]} tb_demo.u_sys.u_array.g_row[0].g_col[3].u_pe.b_in[7:0]
@200
-Accumulators C[i][j] inside the PEs
@424
+{C[0][0]} tb_demo.u_sys.u_array.g_row[0].g_col[0].u_pe.c_out[31:0]
+{C[1][1]} tb_demo.u_sys.u_array.g_row[1].g_col[1].u_pe.c_out[31:0]
+{C[3][3]} tb_demo.u_sys.u_array.g_row[3].g_col[3].u_pe.c_out[31:0]
@28
+{done} tb_demo.done_sys
@24
+{cycle_count} tb_demo.cyc_sys[15:0]
[pattern_trace] 1
[pattern_trace] 0
